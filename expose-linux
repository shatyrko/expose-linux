class AppIcons:
    """app_id -> (display name, icon) from the desktop entries."""

    def __init__(self):
        self.by_key = {}
        for info in Gio.AppInfo.get_all():
            ident = (info.get_id() or "").removesuffix(".desktop").casefold()
            keys = {ident, (info.get_executable() or "").rsplit("/", 1)[-1].casefold()}
            if isinstance(info, DesktopAppInfo):
                wm = info.get_startup_wm_class()
                if wm:
                    keys.add(wm.casefold())
            for key in keys:
                if key:
                    self.by_key.setdefault(key, info)

    def lookup(self, app_id: str):
        info = self.by_key.get((app_id or "").casefold())
        if info is None and app_id:
            info = self.by_key.get(app_id.casefold().rsplit(".", 1)[-1])
        name = (info.get_display_name() if info else None) or app_id or "?"
        icon = (info.get_icon() if info else None) or Gio.ThemedIcon.new("application-x-executable")
        return name, icon


def umbriel_windows() -> list:
    try:
        out = subprocess.run(["umbriel", "windows", "--json"], capture_output=True, text=True, timeout=3).stdout
        data = json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    return data.get("ok", []) if isinstance(data, dict) else data


def sorted_windows(wins: list) -> list:
    """Desktop by desktop, then left to right along each desktop's strip."""
    def key(w):
        return (w.get("output", ""), w.get("workspace", ""), w.get("column", 0), w.get("row", 0), w.get("x", 0), w.get("y", 0))
    return sorted(wins, key=key)


def umbriel_msg(action: str):
    try:
        subprocess.Popen(["umbriel", "msg", action], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as err:
        print(f"expose-linux: umbriel msg failed: {err}", file=sys.stderr)


def shots_command():
    for candidate in (os.path.join(HERE, "tools", "expose-shots"), shutil.which("expose-shots")):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def load_texture(path: str):
    """A Gdk texture from an expose-shots .raw file (a header line, then BGRA premultiplied pixels), or None."""
    try:
        with open(path, "rb") as f:
            data = f.read()
        nl = data.index(b"\n")
        w, h, stride = (int(v) for v in data[:nl].split())
        if len(data) - nl - 1 < stride * h:
            return None
        return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                     GLib.Bytes.new(data[nl + 1:nl + 1 + stride * h]), stride)
    except (OSError, ValueError):
        return None


def ease_out(t: float) -> float:
    return 1 - (1 - t) ** 4


def ease_in_out(t: float) -> float:
    return t * t * (3 - 2 * t)


def fit_rows(aspects: list, area_w: float, area_h: float):
    """The biggest common thumbnail height at which all cards fit in the area, packed in rows left to right.
    Returns (height, rows) with rows = lists of indexes."""
    def pack(h):
        rows, row, width = [], [], 0.0
        for i, a in enumerate(aspects):
            w = h * a + 16                       # the card's padding
            if row and width + GAP + w > area_w:
                rows.append(row)
                row, width = [], 0.0
            width += (GAP if row else 0) + w
            row.append(i)
        rows.append(row)
        return rows

    def fits(h):
        rows = pack(h)
        return len(rows) * (h + LABEL_H + 14) + (len(rows) - 1) * GAP <= area_h

    lo, hi = 40.0, min(area_h * 0.46, 520.0)
    if fits(hi):
        return hi, pack(hi)
    for _ in range(24):
        mid = (lo + hi) / 2
        if fits(mid):
            lo = mid
        else:
            hi = mid
    return lo, pack(lo)


class Card(Gtk.Box):
    """One window: its picture over its title."""

    def __init__(self, win: dict, name: str, icon, workspace_chip: str, on_close):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.win = win
        self.win_id = win["id"]
        self.app_name = name
        self.title_text = win.get("title") or name
        self.aspect = max(0.45, min(3.2, win.get("w", 16) / max(1, win.get("h", 10))))
        self.add_css_class("card")
        overlay = Gtk.Overlay()
        self.shot = Gtk.Picture()
        self.shot.set_content_fit(Gtk.ContentFit.COVER)
        self.shot.set_can_shrink(True)
        self.shot.add_css_class("shot")
        self.shot.set_overflow(Gtk.Overflow.HIDDEN)
        self.placeholder = Gtk.Image.new_from_gicon(icon)
        self.placeholder.set_halign(Gtk.Align.CENTER)
        self.placeholder.set_valign(Gtk.Align.CENTER)
        self.placeholder.set_pixel_size(64)
        overlay.set_child(self.shot)
        overlay.add_overlay(self.placeholder)
        if workspace_chip:
            chip = Gtk.Label(label=workspace_chip)
            chip.add_css_class("chip")
            chip.set_halign(Gtk.Align.END)
            chip.set_valign(Gtk.Align.START)
            chip.set_margin_top(8)
            chip.set_margin_end(8)
            chip.set_can_target(False)
            overlay.add_overlay(chip)
        close = Gtk.Button.new_from_icon_name("window-close-symbolic")
        close.add_css_class("close")
        close.set_halign(Gtk.Align.START)
        close.set_valign(Gtk.Align.START)
        close.set_margin_top(8)
        close.set_margin_start(8)
        close.set_focusable(False)
        close.connect("clicked", lambda b: on_close(self))
        overlay.add_overlay(close)
        self.fades = [self.placeholder, close]          # shown only when the card is (nearly) in place
        if workspace_chip:
            self.fades.append(chip)
        self.append(overlay)
        label = Gtk.Box(spacing=8)
        label.set_halign(Gtk.Align.CENTER)
        small = Gtk.Image.new_from_gicon(icon)
        small.set_pixel_size(22)
        label.append(small)
        title = Gtk.Label(label=self.title_text)
        title.add_css_class("title")
        title.set_ellipsize(Pango.EllipsizeMode.END)
        label.append(title)
        self.title_label = title
        self.label_row = label
        self.fades.append(label)
        self.append(label)
        self.key = f"{self.title_text} {name} {win.get('app_id', '')}".casefold()

    def set_texture(self, texture):
        self.shot.set_paintable(texture)
        self.placeholder.set_visible(False)

    def resize(self, shot_h: float):
        w = int(shot_h * self.aspect)
        self.shot.set_size_request(w, int(shot_h))
        self.title_label.set_max_width_chars(max(8, int(w / 9)))
        self.label_row.set_size_request(w, -1)


class Expose(Gtk.ApplicationWindow):
    def __init__(self, app, windows, icons, palette, alt=False):
        super().__init__(application=app)
        self.alt_held = alt                  # opened by Alt+Tab: Alt is down (until its release is seen)
        self.alt_steps = 0                   # Tab presses on top of the one that opened it, while Alt is down
        self.alt_seen = time.monotonic()
        self.alt_timer = 0
        if alt:
            self.ensure_watch()
        self.progress = 0.0                  # 0 = cards on their windows, 1 = in the grid
        self.anim_id = 0
        self.palette = palette
        self.add_css_class("expose")
        self.icons = icons
        self.cards = []
        self.sel = 0
        self.W = self.H = 0
        self.typed = ""
        self.type_timer = 0
        self.armed = False
        self.last_ptr = None
        self.base_ptr = None
        self.was_active = False
        self.closing = False
        self.opened = time.monotonic()
        self.shots_proc = None
        self.windows = windows

        if LayerShell is not None and LayerShell.is_supported():
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, NAMESPACE)
            LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(self, edge, True)
            LayerShell.set_exclusive_zone(self, -1)
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)
        else:
            self.fullscreen()

        self.root = Gtk.Overlay()
        self.root.add_css_class("root")
        self.root.set_hexpand(True)
        self.root.set_vexpand(True)
        self.set_child(self.root)
        self.board = Gtk.Fixed()
        self.root.set_child(self.board)
        self.empty = Gtk.Label(label="No open windows")
        self.empty.add_css_class("empty")
        self.empty.set_halign(Gtk.Align.CENTER)
        self.empty.set_valign(Gtk.Align.CENTER)
        self.empty.set_visible(False)
        self.root.add_overlay(self.empty)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.on_motion)
        motion.connect("enter", self.on_motion)
        self.add_controller(motion)
        click = Gtk.GestureClick(button=0)
        click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        click.connect("released", self.on_click)
        self.add_controller(click)
        self.connect("notify::is-active", self.on_active)
        self.add_tick_callback(self.wait_for_size)
        self.start_shots()                   # fresh pictures are already being taken while the window opens

    # -- building --------------------------------------------------------------------------------------------------

    def wait_for_size(self, widget, clock):
        w, h = self.get_width(), self.get_height()
        if w < 200 or h < 200:
            return GLib.SOURCE_CONTINUE
        self.W, self.H = w, h
        self.build_cards()
        self.prepare_flights()
        self.set_progress(0.0)
        GLib.idle_add(self.begin_open)
        return GLib.SOURCE_REMOVE

    def build_cards(self):
        wins = sorted_windows(self.windows)
        spaces = sorted({(w.get("output", ""), w.get("workspace", "")) for w in wins})
        multi = len(spaces) > 1
        for w in wins:
            name, icon = self.icons.lookup(w.get("app_id", ""))
            chip = ""
            if multi:
                chip = (w.get("workspace", "").rsplit(":", 1)[-1] or "").strip()
                chip = f"Desktop {chip}" if chip else ""
            card = Card(w, name, icon, chip, self.close_window)
            motion = Gtk.EventControllerMotion()
            motion.connect("enter", lambda c, x, y, card=card: self.on_card_hover(card))
            card.add_controller(motion)
            textures = self.get_application().textures                          # the last picture, until a fresh one arrives
            if w["id"] not in textures:
                texture = load_texture(os.path.join(SHOTS_DIR, f"{w['id']}.raw"))
                if texture is not None:
                    textures[w["id"]] = texture
            if w["id"] in textures:
                card.set_texture(textures[w["id"]])
            self.cards.append(card)
            self.board.put(card, 0, 0)
        self.empty.set_visible(not self.cards)
        focused = next((i for i, c in enumerate(self.cards) if c.win.get("focused")), 0)
        self.layout_cards()
        self.select(focused)

    def layout_cards(self):
        if not self.cards:
            return
        area_w = self.W - 2 * MARGIN_X
        area_h = self.H - MARGIN_TOP - MARGIN_BOTTOM
        height, rows = fit_rows([c.aspect for c in self.cards], area_w, area_h)
        for c in self.cards:
            c.resize(height)
            c.shot_w, c.shot_h = int(height * c.aspect), int(height)
        block_h = len(rows) * (height + LABEL_H + 14) + (len(rows) - 1) * GAP
        row_gap = GAP + (min(max(0.0, area_h - block_h) / (len(rows) - 1), 46) if len(rows) > 1 else 0)   # use spare height
        block_h += (row_gap - GAP) * (len(rows) - 1)
        y = MARGIN_TOP + (area_h - block_h) / 2
        for row in rows:
            row_w = sum(self.cards[i].aspect * height + 16 for i in row) + GAP * (len(row) - 1)
            x = (self.W - row_w) / 2
            for i in row:
                c = self.cards[i]
                self.board.move(c, x, y)
                c.fx, c.fy = x, y
                x += c.aspect * height + 16 + GAP
            y += height + LABEL_H + 14 + row_gap

    # -- the flight: cards zoom from where their windows are to the grid, and back ---------------------------------

    def prepare_flights(self):
        """For every card: the transform that puts its picture exactly over its real window (the start of the flight)."""
        for c in self.cards:
            w = c.win
            x, y, ww, wh = w.get("x", 0), w.get("y", 0), w.get("w", 0), w.get("h", 0)
            on_screen = (w.get("visible") and ww > 0 and wh > 0
                         and x < self.W and y < self.H and x + ww > 0 and y + wh > 0)
            c.on_screen = bool(on_screen)
            if on_screen:
                s0 = max(0.05, ww / max(1, c.shot_w))
                c.flight = ((x - c.fx - 8 * s0), (y - c.fy - 8 * s0), s0)
            else:                                   # not on screen: come out of the middle of the screen
                s0 = 0.42
                c.flight = ((self.W - c.shot_w * s0) / 2 - c.fx - 8 * s0, (self.H - c.shot_h * s0) / 2 - c.fy - 8 * s0, s0)

    def set_progress(self, e: float):
        """e: 0 = cards over their windows, 1 = the grid."""
        self.progress = e
        for c in self.cards:
            if e >= 1.0 or not hasattr(c, "flight"):
                c.remove_css_class("flying")
                self.board.move(c, c.fx, c.fy)                 # (Gtk.Fixed keeps a child's place as its transform)
                c.set_opacity(1.0)
                for widget in c.fades:
                    widget.set_opacity(1.0)
                continue
            dx, dy, s0 = c.flight
            s = s0 + (1 - s0) * e
            tr = Gsk.Transform().translate(Graphene.Point().init(c.fx + dx * (1 - e), c.fy + dy * (1 - e))).scale(s, s)
            self.board.set_child_transform(c, tr)
            c.set_opacity(min(1.0, e * (5.0 if c.on_screen else 3.0)))      # the real window shows through for a moment
            if e < 0.9:                                   # in flight it is just the window's picture: no highlight, no frame
                c.add_css_class("flying")
            else:
                c.remove_css_class("flying")
            late = max(0.0, min(1.0, (e - 0.55) / 0.45))
            for widget in c.fades:
                widget.set_opacity(late if widget is not c.placeholder else (e if e < 0.5 else 1.0))

    def fly(self, direction: int, duration: float, done=None):
        """Run the flight to the grid (+1) or back to the windows (-1) from where it is now."""
        if self.anim_id:
            self.remove_tick_callback(self.anim_id)
            self.anim_id = 0
        start, t0 = self.progress, None
        target = 1.0 if direction > 0 else 0.0
        span = abs(target - start) or 1.0

        def tick(widget, clock):
            nonlocal t0
            now = clock.get_frame_time() / 1e6                   # the frame's own time: steadier than the wall clock
            if t0 is None:
                t0 = now
            t = min(1.0, (now - t0) / (duration * span))
            lin = start + (target - start) * t
            self.set_progress(ease_out(lin) if direction > 0 else ease_in_out(lin))
            if t >= 1.0:
                self.anim_id = 0
                if direction > 0:
                    self.set_progress(1.0)
                if done:
                    done()
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE
        self.anim_id = self.add_tick_callback(tick)

    def begin_open(self):
        self.add_css_class("in")
        self.fly(+1, OPEN_S)
        return GLib.SOURCE_REMOVE

    # -- the pictures ----------------------------------------------------------------------------------------------

    def start_shots(self):
        cmd = shots_command()
        if cmd is None or not self.windows:
            return
        os.makedirs(SHOTS_DIR, exist_ok=True)
        n = len(self.windows)
        width = 1400 if n <= 3 else 1000 if n <= 8 else 760
        try:
            self.shots_proc = Gio.Subprocess.new([cmd, SHOTS_DIR, str(width)], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as err:
            print(f"expose-linux: expose-shots failed: {err.message}", file=sys.stderr)
            return
        stream = Gio.DataInputStream.new(self.shots_proc.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_shot_line, stream)

    def on_shot_line(self, stream, result, _):
        try:
            line, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            return
        if line is None or self.closing:
            return
        parts = line.split()
        if len(parts) >= 2 and parts[0] == "ok":
            texture = load_texture(os.path.join(SHOTS_DIR, f"{parts[1]}.raw"))
            if texture is not None:
                self.get_application().textures[parts[1]] = texture
                card = next((c for c in self.cards if c.win_id == parts[1]), None)
                if card is not None:
                    card.set_texture(texture)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_shot_line, stream)

    # -- selection -------------------------------------------------------------------------------------------------

    def select(self, index):
        if not self.cards:
            return
        index = max(0, min(len(self.cards) - 1, index))
        if 0 <= self.sel < len(self.cards):
            self.cards[self.sel].remove_css_class("selected")
        self.sel = index
        self.cards[index].add_css_class("selected")

    def step(self, which, from_alt=False):
        """Next / previous card in reading order (rows left to right), skipping cards a typed filter dimmed.
        from_alt: it came from Alt+Tab / Alt+Shift+Tab; releasing Alt then goes to the selected window."""
        if from_alt:
            self.alt_held = True
            self.alt_seen = time.monotonic()
            self.alt_steps += 1
            self.ensure_watch()
        n = len(self.cards)
        if not n:
            return
        direction = 1 if which == "next" else -1
        i = self.sel
        for _ in range(n):
            i = (i + direction) % n
            if not self.cards[i].has_css_class("dim"):
                self.select(i)
                return

    def centre(self, card):
        ok, rect = card.compute_bounds(self.board)
        return (rect.get_x() + rect.get_width() / 2, rect.get_y() + rect.get_height() / 2) if ok else (0, 0)

    def move(self, dx, dy):
        if not self.cards:
            return
        cur = self.cards[self.sel]
        cx, cy = self.centre(cur)
        best, best_score = None, None
        for i, c in enumerate(self.cards):
            if i == self.sel or c.has_css_class("dim"):
                continue
            x, y = self.centre(c)
            ax, ay = (x - cx) * dx, (y - cy) * dy          # distance along the direction asked
            if ax + ay <= 4:
                continue
            across = abs(x - cx) if dy else abs(y - cy)
            score = (ax + ay) + 2.5 * across
            if best_score is None or score < best_score:
                best, best_score = i, score
        if best is not None:
            self.select(best)
        elif dx:                                           # at the end of a row: go on to the next / previous card
            step = self.sel + dx
            while 0 <= step < len(self.cards) and self.cards[step].has_css_class("dim"):
                step += dx
            if 0 <= step < len(self.cards):
                self.select(step)

    def keyboard_used(self):
        self.armed = False
        self.base_ptr = self.last_ptr
        self.set_cursor_from_name("none")

    def on_motion(self, ctrl, x, y):
        self.last_ptr = (x, y)
        if time.monotonic() - self.opened < STARTUP_S:
            self.base_ptr = (x, y)
            return
        if self.base_ptr is None:
            self.base_ptr = (x, y)
            return
        if not self.armed and math.hypot(x - self.base_ptr[0], y - self.base_ptr[1]) > HOVER_PX:
            self.armed = True
            self.set_cursor(None)

    def on_card_hover(self, card):
        if self.armed and card in self.cards:
            self.select(self.cards.index(card))

    # -- typing, keys ----------------------------------------------------------------------------------------------

    def apply_filter(self):
        text = self.typed.casefold()
        first = None
        for i, c in enumerate(self.cards):
            match = not text or any(word.startswith(text) or text in c.key for word in [c.key])
            (c.remove_css_class if match else c.add_css_class)("dim")
            if match and first is None and text:
                first = i
        if first is not None:
            self.select(first)

    def clear_typed(self):
        self.typed = ""
        if self.type_timer:
            GLib.source_remove(self.type_timer)
            self.type_timer = 0
        self.apply_filter()

    def on_key(self, ctrl, keyval, keycode, state):
        name = Gdk.keyval_name(keyval) or ""
        if state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK | Gdk.ModifierType.SUPER_MASK):
            return Gdk.EVENT_PROPAGATE
        self.keyboard_used()
        if name == "Escape":
            if self.typed:
                self.clear_typed()
            else:
                self.close_pad()
        elif name in ("Return", "KP_Enter", "ISO_Enter"):
            self.activate(self.cards[self.sel]) if self.cards else self.close_pad()
        elif name == "Left":
            self.move(-1, 0)
        elif name == "Right":
            self.move(1, 0)
        elif name == "Up":
            self.move(0, -1)
        elif name == "Down":
            self.move(0, 1)
        elif name in ("Tab", "ISO_Left_Tab"):
            self.step("prev" if (state & Gdk.ModifierType.SHIFT_MASK) else "next")
        elif name in ("Delete", "BackSpace"):
            if self.typed:
                self.typed = self.typed[:-1]
                self.apply_filter()
            elif name == "Delete" and self.cards:
                self.close_window(self.cards[self.sel])
        elif len(name) == 1 or name == "space":
            char = " " if name == "space" else name
            if char.strip() or self.typed:
                self.typed += char
                if self.type_timer:
                    GLib.source_remove(self.type_timer)
                self.type_timer = GLib.timeout_add(int(TYPE_RESET_S * 1000), self.type_expired)
                self.apply_filter()
        return Gdk.EVENT_STOP

    def ensure_watch(self):
        if not self.alt_timer:
            self.alt_timer = GLib.timeout_add(30, self.watch_alt)

    def watch_alt(self):
        """Alt+Tab: Alt is down while it opens. GTK only reports Alt's release as a key event to the window that saw
        its press, so look at the keyboard's modifier state every 30 ms instead. Letting go of Alt after Tab was pressed
        again goes to the selected window at once; a plain Alt+Tab and release stays open."""
        seat = self.get_display().get_default_seat()
        keyboard = seat.get_keyboard() if seat else None
        app = self.get_application()
        # With Kanata (Win = Command, Alt = Option) a held Alt is Kanata's layer "opt"; Alt+Tab reaches the compositor as a
        # quick Alt+Tab that is already released. In a terminal Alt is the real one, which GTK sees.
        down = bool(keyboard and keyboard.get_modifier_state() & Gdk.ModifierType.ALT_MASK) \
            or (app.kanata_ok and app.layer == "opt")
        if os.environ.get("EXPOSE_DEBUG"):
            print("alt", down, self.alt_held, self.alt_steps, file=sys.stderr, flush=True)
        if self.closing or not self.alt_held:
            self.alt_timer = 0
            return GLib.SOURCE_REMOVE
        if down:
            self.alt_seen = time.monotonic()
            return GLib.SOURCE_CONTINUE
        if time.monotonic() - self.alt_seen < (0.05 if app.kanata_ok else 0.3):     # the state can lag a moment
            return GLib.SOURCE_CONTINUE
        self.alt_held = False
        self.alt_timer = 0
        if self.alt_steps > 0 and self.cards:
            self.activate(self.cards[self.sel])
        return GLib.SOURCE_REMOVE

    def type_expired(self):
        self.type_timer = 0
        self.typed = ""
        self.apply_filter()
        return GLib.SOURCE_REMOVE

    # -- mouse -----------------------------------------------------------------------------------------------------

    def on_click(self, gesture, n_press, x, y):
        button = gesture.get_current_button()
        widget = self.pick(x, y, Gtk.PickFlags.DEFAULT)
        node = widget
        while node is not None and not isinstance(node, (Card, Gtk.Button)):
            node = node.get_parent()
        if isinstance(node, Gtk.Button):
            return                                        # the x on a card has its own handler
        if isinstance(node, Card):
            if button == 1:
                self.activate(node)
            elif button == 2:
                self.close_window(node)
        elif button == 1:
            self.close_pad()

    # -- doing things ----------------------------------------------------------------------------------------------

    def activate(self, card):
        umbriel_msg(f"window-focus:{card.win_id}")
        self.close_pad()

    def close_window(self, card):
        umbriel_msg(f"window-close:{card.win_id}")
        GLib.timeout_add(450, self.refresh_windows)

    def refresh_windows(self):
        """After a close request: drop the cards of windows that are gone and tidy the rest."""
        if self.closing:
            return GLib.SOURCE_REMOVE
        alive = {w["id"] for w in umbriel_windows()}
        gone = [c for c in self.cards if c.win_id not in alive]
        if gone:
            keep = self.cards[self.sel] if self.sel < len(self.cards) and self.cards[self.sel] not in gone else None
            for c in gone:
                self.cards.remove(c)
                self.board.remove(c)
            if not self.cards:
                self.empty.set_visible(True)
            else:
                self.layout_cards()
                self.select(self.cards.index(keep) if keep in self.cards else min(self.sel, len(self.cards) - 1))
        return GLib.SOURCE_REMOVE

    def on_active(self, *args):
        if self.is_active():
            self.was_active = True
        elif self.was_active and not self.closing:
            GLib.timeout_add(200, self.close_if_inactive)

    def close_if_inactive(self):
        if not self.is_active():
            self.close_pad(animated=False)
        return GLib.SOURCE_REMOVE

    def close_pad(self, animated=True):
        if self.closing:
            return GLib.SOURCE_REMOVE
        self.closing = True
        if self.shots_proc is not None:
            self.shots_proc.force_exit()
        app = self.get_application()
        if animated and self.cards and self.W:
            self.remove_css_class("in")                      # the backdrop fades while the cards fly back
            self.fly(-1, CLOSE_S, done=lambda: app.pad_closed(self))
        else:
            app.pad_closed(self)
        return GLib.SOURCE_REMOVE


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.icons = None
        self.layer = "base"           # Kanata's active layer ("opt" = Alt is held), from its TCP server
        self.kanata_ok = False
        self.textures = {}            # window id -> last picture (kept between openings: they show at once)
        self.css = None
        self.palette = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()                                  # stays running with the window closed
        for name in ("next", "prev"):                # Alt+Tab / Alt+Shift+Tab: `expose-toggle next|prev` over D-Bus
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda a, p, name=name: self.step(name))
            self.add_action(action)
        threading.Thread(target=self.kanata_loop, daemon=True).start()
        GLib.idle_add(self.warm_up)

    def warm_up(self):
        """Do the slow first-time work now (desktop entries, the style sheet), not when the first Alt+Tab is pressed."""
        if self.icons is None:
            self.icons = AppIcons()
        self.apply_palette()
        return GLib.SOURCE_REMOVE

    def apply_palette(self):
        palette = load_palette()
        if palette != self.palette:
            self.palette = palette
            if self.css is None:
                self.css = Gtk.CssProvider()
                Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
            self.css.load_from_string(make_css(palette))
        return palette

    def kanata_loop(self):
        host, port = KANATA_ADDR.rsplit(":", 1)
        while True:
            try:
                with socket.create_connection((host, int(port)), timeout=2) as conn:
                    conn.settimeout(None)
                    GLib.idle_add(self.set_kanata, True, None)
                    for line in conn.makefile():
                        try:
                            new = json.loads(line).get("LayerChange", {}).get("new")
                        except (ValueError, AttributeError):
                            continue
                        if new:
                            GLib.idle_add(self.set_kanata, True, new)
            except OSError:
                pass
            GLib.idle_add(self.set_kanata, False, "base")
            time.sleep(5)

    def set_kanata(self, ok, layer):
        self.kanata_ok = ok
        if layer:
            self.layer = layer
        return GLib.SOURCE_REMOVE

    def do_activate(self):                           # `gdbus call ... org.freedesktop.Application.Activate`: the fast toggle
        self.toggle()

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        if "--background" in args:
            return 0
        if "--quit" in args:
            self.release()
            self.quit()
            return 0
        if "--step" in args:
            self.step(args[args.index("--step") + 1] if args.index("--step") + 1 < len(args) else "next")
            return 0
        self.toggle()
        return 0

    # -- open / close ------------------------------------------------------------------------------------------------

    def step(self, which):
        """Alt+Tab / Alt+Shift+Tab: the first one opens it, the next ones step on."""
        if self.win is None:
            self.open(alt=True)
        else:
            self.win.step(which, from_alt=True)
            self.win.keyboard_used()

    def toggle(self):
        if self.win is not None:
            self.win.close_pad()
        else:
            self.open()
        return GLib.SOURCE_REMOVE

    def open(self, alt=False):
        windows = umbriel_windows()
        if self.icons is None:
            self.icons = AppIcons()
        self.win = Expose(self, windows, self.icons, self.apply_palette(), alt=alt)
        if alt:
            self.win.keyboard_used()
        self.win.present()

    def pad_closed(self, win):
        self.win = None
        win.destroy()


def main():
    if "--list" in sys.argv:
        for w in sorted_windows(umbriel_windows()):
            print(f"{w['id']}  {w.get('workspace', '')}  {w.get('app_id', '')}  {w.get('title', '')}")
        return 0
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return 0
    return App().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
