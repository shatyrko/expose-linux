#!/bin/sh
# Open / close Expose Linux at once (what keyboard shortcuts run): asks the background program over D-Bus,
# which takes milliseconds; starts it when it is not running.
#   expose-toggle          open / close
#   expose-toggle next     Alt+Tab: open with the window used before this one selected, or step on to the next
#   expose-toggle prev     Alt+Shift+Tab: the same backwards
dest="--dest dev.alecsh.ExposeLinux --object-path /dev/alecsh/ExposeLinux"
case "${1:-}" in
    next|prev)
        gdbus call --session $dest --method org.freedesktop.Application.ActivateAction "$1" '[]' '{}' >/dev/null 2>&1 \
            || exec expose-linux --step "$1" ;;
    *)
        gdbus call --session $dest --method org.freedesktop.Application.Activate '{}' >/dev/null 2>&1 \
            || exec expose-linux ;;
esac
